{
  "all": true,
  "include": ["src/**/*.ts"],
  "exclude": ["src/types.ts", "src/**/*.test.ts", "test/**", "dist/**", "examples/**"],
  "extension": [".ts"],
  "reporter": ["text", "lcov"],
  "reports-dir": "coverage",
  "exclude-after-remap": true,
  "check-coverage": true,
  "lines": 80,
  "functions": 80,
  "branches": 80
}
