{
  "name": "@quxkit/identity-kit",
  "version": "0.2.0",
  "packageManager": "pnpm@11.20.0",
  "description": "User identity and authentication as a library \u2014 accounts, credentials and sessions, over a provider-agnostic executor.",
  "license": "Apache-2.0",
  "author": "BRETT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QuxKit/identity-kit.git"
  },
  "homepage": "https://github.com/QuxKit/identity-kit#readme",
  "keywords": [
    "authentication",
    "identity",
    "user-management",
    "accounts",
    "sessions",
    "passkeys",
    "webauthn",
    "password",
    "argon2",
    "postgres",
    "typescript"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./mfa": {
      "types": {
        "import": "./dist/mfa.d.ts",
        "require": "./dist/mfa.d.cts"
      },
      "import": "./dist/mfa.mjs",
      "require": "./dist/mfa.cjs"
    },
    "./apikeys": {
      "types": {
        "import": "./dist/apikeys.d.ts",
        "require": "./dist/apikeys.d.cts"
      },
      "import": "./dist/apikeys.mjs",
      "require": "./dist/apikeys.cjs"
    },
    "./oidc": {
      "types": {
        "import": "./dist/oidc.d.ts",
        "require": "./dist/oidc.d.cts"
      },
      "import": "./dist/oidc.mjs",
      "require": "./dist/oidc.cjs"
    },
    "./passkeys": {
      "types": {
        "import": "./dist/passkeys.d.ts",
        "require": "./dist/passkeys.d.cts"
      },
      "import": "./dist/passkeys.mjs",
      "require": "./dist/passkeys.cjs"
    },
    "./magic": {
      "types": {
        "import": "./dist/magic.d.ts",
        "require": "./dist/magic.d.cts"
      },
      "import": "./dist/magic.mjs",
      "require": "./dist/magic.cjs"
    },
    "./http": {
      "types": {
        "import": "./dist/http.d.ts",
        "require": "./dist/http.d.cts"
      },
      "import": "./dist/http.mjs",
      "require": "./dist/http.cjs"
    },
    "./pg": {
      "types": {
        "import": "./dist/pg.d.ts",
        "require": "./dist/pg.d.cts"
      },
      "import": "./dist/pg.mjs",
      "require": "./dist/pg.cjs"
    },
    "./sql/*": "./sql/*",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "sql",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "test:coverage": "c8 pnpm test",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm build && pnpm test"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.0",
    "@simplewebauthn/server": "^13.3.2",
    "openid-client": "^6.8.5",
    "otpauth": "^9.3.0"
  },
  "peerDependencies": {
    "pg": "^8.11.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.21.0",
    "c8": "^12.0.0",
    "pg": "^8.23.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "bugs": {
    "url": "https://github.com/QuxKit/identity-kit/issues"
  }
}
